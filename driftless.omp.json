{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "bright-yellow": "226",
    "dark-grey": "8",
    "dark-olive": "107",
    "gold": "220",
    "hot-pink": "205",
    "light-grey": "248",
    "powder-blue": "153",
    "slate": "105",
    "steel": "189"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "time_format": "2 January 15:04"
          },
          "type": "time",
          "style": "plain"
        },
        {
          "properties": {
            "branch_icon": "",
            "cache_duration": "none"
          },
          "template": "±({{ .HEAD }}) {{ if gt .Ahead 0 }} \u2191{{ .Ahead }} {{ end }}{{ if gt .Behind 0 }}\u2193{{ .Behind }} {{ end }}{{ if .Working.Changed }}{{ .Working.String }} {{ end }}",
          "foreground": "p:light-grey",
          "type": "git",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "{{ if .Root }}<red>{{ .UserName }}</>{{ else }}<p:gold>{{ .UserName }}</>{{ end }}@{{ if .SSHSession }}<p:powder-blue>{{ .HostName }}</>{{ else }}<p:hot-pink>{{ .HostName }}</>{{ end }}",
          "foreground": "p:steel",
          "type": "session",
          "style": "plain"
        },
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "/",
            "style": "full"
          },
          "foreground": "p:dark-olive",
          "type": "path",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "    ⚡︎",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
